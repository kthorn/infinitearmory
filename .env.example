# Database
DATABASE_URL=file:./dev.db

# AI Providers (set the ones you'll use)
TEXT_PROVIDER=openai
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# S3 Storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Storage (local filesystem)
# STORAGE_DIR=./public/uploads  # Override image storage path (default: ./public/uploads, production: /data/uploads)

# Scale-to-zero (production only)
# IDLE_SHUTDOWN_MINUTES=60  # Minutes of inactivity before machine shuts down (default: 60)

# Auth
AUTH_PASSWORD=
